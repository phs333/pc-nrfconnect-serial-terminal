{
    "name": "pc-nrfconnect-serial-terminal",
    "version": "1.7.0",
    "description": "Terminal emulator with configurable macro buttons for serial port connections",
    "displayName": "Serial Terminal (with Macros)",
    "repository": {
        "type": "git",
        "url": "https://github.com/phs333/pc-nrfconnect-serial-terminal.git"
    },
    "author": "Nordic Semiconductor ASA",
    "license": "SEE LICENSE IN LICENSE",
    "engines": {
        "nrfconnect": ">=5.2.0"
    },
    "nrfConnectForDesktop": {
        "nrfutil": {
            "device": [
                "2.19.3"
            ]
        },
        "html": "dist/index.html",
        "nrfutilCore": "8.1.1"
    },
    "main": "dist/bundle.js",
    "files": [
        "dist/",
        "!dist/*.map",
        "resources/icon.*",
        "resources/screenshoot.gif",
        "LICENSE",
        "Changelog.md"
    ],
    "scripts": {
        "watch": "run-p --silent --continue-on-error watch:*",
        "watch:build": "run-esbuild --watch",
        "watch:types": "tsc --noEmit --pretty --watch --preserveWatchOutput",
        "build:dev": "run-esbuild && node ./scripts/patch-index-html.js",
        "build:prod": "run-esbuild --prod && node ./scripts/patch-index-html.js",
        "test": "jest --passWithNoTests",
        "check": "run-p --silent --continue-on-error --print-label check:*",
        "check:lint": "eslint --color .",
        "check:types": "check-for-typescript tsc --noEmit --pretty",
        "check:license": "nrfconnect-license check",
        "nordic-publish": "node ./dist/nordic-publish.js",
        "prepare": "husky install"
    },
    "devDependencies": {
        "@nordicsemiconductor/pc-nrfconnect-shared": "^252.0.0",
        "ansi-escapes": "^4.3.2",
        "serialport": "^10.5.0",
        "xterm-addon-fit": "^0.8.0",
        "xterm-for-react": "github:NordicPlayground/xterm-for-react"
    },
    "prettier": "@nordicsemiconductor/pc-nrfconnect-shared/config/prettier.config.js",
    "resolutions": {
        "@types/react": "17.0.55",
        "@types/react-dom": "17.0.19"
    }
}
